{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "report-automation",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daily-report-db",
      "database_id": "aec62ee4-b689-48ad-8c9d-899579749b57"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://report-automation.taion16240.workers.dev",
    "BOOTSTRAP_ADMIN_EMAIL": "Taion@razibmarketing.net",
    "TEAM_TIMEZONE": "Asia/Dhaka"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
