# -----------------------------------------------------------------------------
# Better Auth / Google OAuth Credentials
# -----------------------------------------------------------------------------
# Generate in Google Cloud Console > APIs & Services > Credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# (and https://<your-pages-subdomain>.pages.dev/api/auth/callback/google in production)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"

# Random 32+ char secret for signing session cookies
BETTER_AUTH_SECRET="a-secure-random-string-at-least-32-chars-long"
BETTER_AUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Admin Bootstrap
# -----------------------------------------------------------------------------
# The Google email of the person who should automatically be promoted to 'admin'
# upon first login.
BOOTSTRAP_ADMIN_EMAIL="admin@yourcompany.com"

# -----------------------------------------------------------------------------
# Team Timezone Config
# -----------------------------------------------------------------------------
# IANA Timezone string for cutoff logic (defaults to Asia/Dhaka)
TEAM_TIMEZONE="Asia/Dhaka"

# -----------------------------------------------------------------------------
# Cloudflare D1 (For remote migration execution via Drizzle Kit)
# -----------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_D1_DATABASE_ID=""
CLOUDFLARE_D1_TOKEN=""
