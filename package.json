{
  "name": "report-automation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "opennextjs-cloudflare build",
    "build:next": "next build",
    "start": "next start",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 execute daily-report-db --local --file=./migrations/0000_initial.sql",
    "db:migrate:prod": "wrangler d1 execute daily-report-db --remote --file=./migrations/0000_initial.sql"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.3",
    "@tailwindcss/postcss": "^4.3.3",
    "better-auth": "^1.7.2",
    "drizzle-orm": "^0.45.2",
    "next": "^15.5.24",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.126.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3"
  }
}
